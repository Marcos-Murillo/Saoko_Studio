rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUserPath() {
      return /databases/$(database)/documents/adminUsers/$(request.auth.uid);
    }

    function myProfile() {
      return get(myUserPath()).data;
    }

    function isActiveUser() {
      return signedIn()
        && exists(myUserPath())
        && myProfile().isActive == true;
    }

    function role() {
      return myProfile().role;
    }

    function isOps() {
      return isActiveUser() && role() in ['staff', 'admin', 'super_admin'];
    }

    function isAdmin() {
      return isActiveUser() && role() in ['admin', 'super_admin'];
    }

    function isSuper() {
      return isActiveUser() && role() == 'super_admin';
    }

    function isStudent() {
      return isActiveUser() && role() == 'student';
    }

    function isInternal() {
      return isActiveUser() && role() in ['teacher', 'staff', 'admin', 'super_admin'];
    }

    function myDancerId() {
      return myProfile().dancerId;
    }

    function emailMatches(value) {
      return request.auth.token.email is string
        && value is string
        && value.trim().lower() == request.auth.token.email.trim().lower();
    }

    function isUnclaimed(data) {
      return !data.keys().hasAny(['authUid'])
        || data.authUid == null
        || data.authUid == request.auth.uid;
    }

    function ownsDancer(dancerId) {
      let dancer = get(/databases/$(database)/documents/dancers/$(dancerId)).data;
      let claimPath = /databases/$(database)/documents/dancerClaims/$(request.resource.data.documentNumber);
      let byClaim = request.resource.data.documentNumber is string
        && exists(claimPath)
        && get(claimPath).data.dancerId == dancerId
        && emailMatches(get(claimPath).data.email);
      return isUnclaimed(dancer) && (emailMatches(dancer.email) || byClaim);
    }

    // Document ID MUST equal Firebase Auth UID. Create the first super_admin
    // in the console: Authentication user + document adminUsers/{uid}.
    match /adminUsers/{userId} {
      allow get: if signedIn() && (
        userId == request.auth.uid
        || resource.data.uid == request.auth.uid
        || isAdmin()
      );
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if (
        isAdmin()
        && request.resource.data.uid == userId
        && (
          isSuper()
          || request.resource.data.role in ['admin', 'staff', 'teacher']
        )
      ) || (
        signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'super_admin'
        && request.resource.data.isActive == true
        && request.auth.token.email.matches('superadmin\\..+@saokostudio\\.internal')
      ) || (
        signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'student'
        && request.resource.data.isActive == true
        && request.resource.data.mustSetPassword == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.dancerId is string
        && request.resource.data.documentNumber is string
        && request.resource.data.name is string
        && ownsDancer(request.resource.data.dancerId)
      );
      allow update: if (
        isAdmin()
        && (
          isSuper()
          || resource.data.role != 'super_admin'
        )
      ) || (
        signedIn()
        && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mustSetPassword', 'updatedAt'])
        && request.resource.data.mustSetPassword == false
      );
      allow delete: if false;
    }

    // Cédula → email for login. Get is public so users can sign in with document
    // number; listing is denied so the directory cannot be enumerated.
    match /loginAliases/{documentNumber} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.mustSetPassword == false
        && exists(myUserPath())
        && myProfile().role == 'student'
        && myProfile().documentNumber == documentNumber
      );
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['mustSetPassword'])
          && request.resource.data.mustSetPassword == false
        );
    }

    match /modalities/{id} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    match /levels/{id} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    match /paymentMethods/{id} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    match /expenseCategories/{id} {
      allow read: if isOps();
      allow write: if isAdmin();
    }

    match /dancerClaims/{cedula} {
      allow get: if true;
      allow list: if isOps()
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if isOps() || (
        signedIn()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.dancerId is string
      );
      allow update: if isOps() || (
        signedIn()
        && emailMatches(resource.data.email)
        && emailMatches(request.resource.data.email)
        && request.resource.data.dancerId == resource.data.dancerId
        && request.resource.data.authUid == request.auth.uid
        && isUnclaimed(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['authUid', 'missing', 'fullName', 'isActive', 'documentKey'])
      );
      allow delete: if false;
    }

    match /dancers/{id} {
      allow get: if isInternal() || (
        signedIn() && (
          (exists(myUserPath()) && myProfile().role == 'student' && id == myProfile().dancerId)
          || resource.data.authUid == request.auth.uid
        )
      );
      allow list: if isInternal()
        || (signedIn() && resource.data.email == request.auth.token.email)
        || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create: if isOps() || (
        signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isActive == true
        && request.resource.data.documentNumber is string
        && request.resource.data.fullName is string
        && !exists(/databases/$(database)/documents/dancerClaims/$(request.resource.data.documentNumber))
      );
      allow update: if isOps() || (
        signedIn()
        && exists(myUserPath())
        && myProfile().role == 'student'
        && myProfile().dancerId == id
        && (emailMatches(resource.data.email) || resource.data.authUid == request.auth.uid)
        && (emailMatches(request.resource.data.email) || request.resource.data.email == resource.data.email)
        && request.resource.data.authUid == request.auth.uid
        && isUnclaimed(resource.data)
        && request.resource.data.documentNumber == resource.data.documentNumber
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.fullName is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authUid', 'fullName', 'phone', 'address', 'neighborhood', 'commune', 'city',
          'birthDate', 'gender', 'eps', 'epsLocation', 'bloodType', 'photoUrl',
          'email', 'documentKey', 'updatedAt'
        ])
      );
      allow delete: if isOps();
    }
    match /guardians/{id} {
      allow read: if isInternal();
      allow write: if isOps();
    }
    match /dancerGuardians/{id} {
      allow read: if isInternal();
      allow write: if isOps();
    }

    match /groups/{id} {
      allow read: if isActiveUser();
      allow write: if isOps();
    }
    match /groupMemberships/{id} {
      allow read: if isInternal() || (isStudent() && resource.data.dancerId == myDancerId());
      allow write: if isOps();
    }
    match /schedules/{id} {
      allow read: if isActiveUser();
      allow write: if isOps();
    }

    match /monthlyFees/{id} {
      allow read: if isOps() || (isStudent() && resource.data.dancerId == myDancerId());
      allow write: if isOps();
    }
    match /payments/{id} {
      allow read: if isOps() || (isStudent() && resource.data.dancerId == myDancerId());
      allow write: if isOps();
    }
    match /paymentAllocations/{id} {
      allow read, write: if isOps();
    }
    match /dancerCredits/{id} {
      allow read: if isOps() || (isStudent() && resource.data.dancerId == myDancerId());
      allow write: if isOps();
    }
    match /creditTransactions/{id} {
      allow read, write: if isOps();
    }
    match /expenses/{id} {
      allow read, write: if isOps();
    }

    match /costumes/{id} {
      allow read, write: if isOps();
    }
    match /costumeLoans/{id} {
      allow read, write: if isOps();
    }

    match /events/{id} {
      allow read, write: if isOps();
    }
    match /eventCategories/{id} {
      allow read, write: if isOps();
    }
    match /eventRegistrations/{id} {
      allow read, write: if isOps();
    }
    match /eventPayments/{id} {
      allow read, write: if isOps();
    }

    match /appSettings/{id} {
      allow read: if isOps();
      allow write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isOps();
      allow update, delete: if false;
    }
  }
}
